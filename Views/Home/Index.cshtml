@model GeneradorContraseñas.Models.Password

<style>
        body {
            background-color: white;
        }

        .contenedor {
            width: 420px;
            margin: 40px auto;
            padding: 25px;
            background-color: white;
            border: 1px solid gray;
            border-radius: 5px;
        }

        .titulo {
            background-color: white;
            color: black;
            padding: 15px;
            margin: -25px -25px 20px -25px;
            border-bottom: 1px solid gray;
        }

        .campo {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            box-sizing: border-box;
        }

        .opciones {
            margin: 15px 0;
            line-height: 30px;
        }

        .boton {
            padding: 10px 18px;
            cursor: pointer;
        }

        .error {
            color: red;
            margin-top: 15px;
        }

        .resultado {
            margin-top: 20px;
            padding: 15px;
            background-color: white;
            border: 1px solid gray;
            overflow-wrap: anywhere;
    }
</style>

<div class="contenedor">

    <div class="titulo">
                <h1>Generador de Contraseñas</h1>
                <p>Crea tu propia contraseña</p>
    </div>

    <form asp-controller="Password" asp-action="Index"
          method="post" novalidate>

                <p>Longitud de la contraseña:</p>

                <input asp-for="Largo"
                       type="number"
                       class="campo" />

        <p>Selecciona los caracteres:</p>

        <div class="opciones">

                    <input asp-for="Mayusculas" type="checkbox" />
                    Mayúsculas

                    <br />

                    <input asp-for="Minusculas" type="checkbox" />
                    Minúsculas

                    <br />

                    <input asp-for="Numeros" type="checkbox" />
                    Números

                    <br />

                    <input asp-for="Simbolos" type="checkbox" />
                    Símbolos

        </div>

        <button type="submit" class="boton">
                  Generar contraseña
        </button>

    </form>

    @if (ViewBag.Error != null)
    {
        <p class="error">@ViewBag.Error</p>
    }

    @if (!string.IsNullOrEmpty(Model.Resultado))
    {
          <div class="resultado">

                    <h3>Tu contraseña es:</h3>

                    <h2>@Model.Resultado</h2>

        </div>
    }

</div>
